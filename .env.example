# ─── LLM: любой OpenAI-совместимый провайдер ─────────────────────────────────
# Провайдер и модель меняются этими переменными, без правок кода.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Быстрая модель для коротких вызовов. Пусто — берётся LLM_MODEL.
LLM_MODEL_FAST=
LLM_TEMPERATURE=0.6
LLM_MAX_CONCURRENCY=8
LLM_MAX_TOKENS=700
LLM_MAX_TOKENS_SHORT=200

# ─── Бюджет хода (секунды) ───────────────────────────────────────────────────
# Промах — деградация в аварийную реплику, а не ожидание.
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=8
TURN_BUDGET_SECONDS=9
CONTEXT_TOOL_TIMEOUT=1.2

# ─── Прокси: включается и отключается флагом ─────────────────────────────────
IS_PROXY=false
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
# http / socks5h. Пусто — схема выбирается по номеру порта.
PROXY_SCHEME=

# ─── Справочник Vector KB ────────────────────────────────────────────────────
# Общей docker-сети со стеком справочника нет: ходим через шлюз хоста.
VECTOR_KB_URL=http://host.docker.internal:8317
VECTOR_KB_TIMEOUT=2
VECTOR_KB_CACHE_TTL=3600

# ─── Скрипт разговора ────────────────────────────────────────────────────────
SCRIPT_ID=vector_ru
# Пусто — берётся последняя версия из каталога (сейчас v2).
SCRIPT_VERSION=
SCRIPT_DIR=
# Порог попыток задать шаг (ведущий ход); исчерпан — чекер закрывает без модели.
STEP_ATTEMPT_LIMIT=2
# Висящих в шапке ≥ N — новый шаг с верхушки не добираем, дорабатываем висящее.
PENDING_STEPS_SOFT_CAP=4

# ─── Служебный чекер в реальном времени ──────────────────────────────────────
# Порог прироста накопленного текста (символы) между служебными проходами.
CHECKER_MIN_GROWTH_CHARS=10
# Имя графа в langgraph.json. Пусто — vector_checker.
CHECKER_GRAPH_ID=
# multitask_strategy для SDK: interrupt — новый служебный отменяет прежний.
CHECKER_MULTITASK_STRATEGY=
# multitask_strategy основного хода. Пусто — enqueue. Перед стартом клиент
# отменяет идущий vector_checker, иначе основной ход встанет в очередь.
AGENT_MULTITASK_STRATEGY=

# ─── Redis: прогресс скрипта звонка ──────────────────────────────────────────
# Совпадает с REDIS_URI сервера. Секретов нет — только адрес.
REDIS_URI=redis://localhost:6379
SCRIPT_REDIS_TTL=7200

# ─── Заглушка в эфир ─────────────────────────────────────────────────────────
# Фразы города/филиала: по умолчанию выключены до переделки формулировок.
LOOKUP_FILLERS_ENABLED=false

# ─── Наблюдаемость ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LANGSMITH_PROJECT=vector-voice-agent
LANGSMITH_API_KEY=
